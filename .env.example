# Next.js server tarafı proxy hedefi (backend adresi; protokol zorunlu degil ama onerilir)
# Local: http://localhost:8000
# Railway/Vercel: https://sepsis-back-production.up.railway.app
BACKEND_API_URL=http://localhost:8000

# Client tarafında kullanılacak API base URL
# Local geliştirmede /api bırakılması önerilir (rewrite kullanır).
NEXT_PUBLIC_API_BASE_URL=/api
